# ONA Records — backend environment template
#
#   cp .env.example .env
#
# Every variable below is read somewhere in config/settings/ or apps/.
# Copy this file, fill it in, and never commit the result — .env is gitignored.
#
# On Railway do NOT set DATABASE_URL or REDIS_URL by hand: Railway injects
# them into every service in the same environment, and rotates them.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# local | staging | production. A deployed container that leaves this unset
# falls back to local settings (DEBUG=True, no security middleware), so
# start.sh refuses to boot without it.
DJANGO_SETTINGS_MODULE=config.settings.local

# local.py reads DJANGO_SECRET_KEY; staging/production read SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=insecure-local-key-do-not-deploy
# SECRET_KEY=

# Comma-separated bare hostnames — no scheme, no trailing slash.
ALLOWED_HOSTS=localhost,127.0.0.1

LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Port 5433, not 5432: docker-compose maps it there so this project does not
# collide with a Postgres installed directly on the host. Windows lets both
# bind 5432 and routes to whichever won the race, which fails authentication
# against a server that has no 'ona' user.
DATABASE_URL=postgres://ona:ona@127.0.0.1:5433/ona_dev

# Production/staging only.
# DB_CONN_MAX_AGE=600
# DB_SSL_REQUIRE=True

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6380/0
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
# FRONTEND_URL builds the links inside verification and reset emails.
FRONTEND_URL=http://localhost:3000

# Full origins WITH scheme — unlike ALLOWED_HOSTS, which is bare hostnames.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Locally, emails print to the terminal instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ONA Records <dev@localhost>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Staging only. Any database restored from production carries real customer
# addresses, so staging redirects every message to one inbox rather than
# emailing people about bookings that never happened.
# STAGING_EMAIL_REDIRECT_TO=you@example.com

# ---------------------------------------------------------------------------
# Money
# ---------------------------------------------------------------------------
# Amounts are integer PESEWAS everywhere. GHS 12.50 is 1250. Never float.
#
# This is the default for NEW rows only. The rate that applied is stored on
# each transaction, so changing it must never alter what a past payment was
# worth.
DEFAULT_COMMISSION_PERCENT=15

# Flat studio booking fee, in pesewas. 4800 = GHS 48.00
BOOKING_FEE_PESEWAS=4800

FREE_CANCELLATION_HOURS=48

# ---------------------------------------------------------------------------
# Hubtel — mobile money (needed Week 4, not before)
# ---------------------------------------------------------------------------
# Credentials come from the Hubtel team; there is no self-service signup.
# Ask explicitly for a TEST/sandbox merchant account.
HUBTEL_API_KEY=
HUBTEL_API_SECRET=
HUBTEL_MERCHANT_ID=
HUBTEL_POS_SALES_ID=

# Must be publicly reachable. Locally use a tunnel (ngrok, cloudflared) —
# Hubtel cannot call back to localhost.
HUBTEL_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback/

# Hubtel keys are not self-identifying as live or test, so staging refuses to
# start with credentials present unless this is explicitly True.
HUBTEL_TEST_MODE=True

# SMS uses separate credentials from the payment API.
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER_ID=ONARecords

# ---------------------------------------------------------------------------
# Cloudinary — portfolio uploads (needed Week 4, not before)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Sentry — optional
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Whole percent ONA keeps on studio-booking payments. 0 until ONA decides (spec OQ3).
# Frozen per transaction: changing it never re-prices past payments.
STUDIO_COMMISSION_PERCENT=0

# Customers must confirm their email before booking. On in staging and
# production (base default); off in local settings for E2E.
BOOKING_REQUIRES_VERIFIED_EMAIL=False
